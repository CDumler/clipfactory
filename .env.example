# ========= PFLICHT =========

TZ=Europe/Berlin

# --- Twitch (dev.twitch.tv) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- OpenAI (platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ========= PROFIL DE (deutsche Streamer -> deutsche Accounts) =========
# YouTube: Dateien nach ./secrets/de/  (client_secret.json + token.json)
# Fuer reinen Review-/Telegram-Betrieb statt Upload: PLATFORMS_DE=none
PLATFORMS_DE=youtube
YOUTUBE_PRIVACY_STATUS_DE=private
# Fuer nur manuellen Upload ueber den Telegram-Button: UPLOAD_TIMES_DE=none
UPLOAD_TIMES_DE=10:00
COLLECT_TIME_DE=06:30
IG_USER_ID_DE=
IG_ACCESS_TOKEN_DE=
TIKTOK_ACCESS_TOKEN_DE=

# ========= PROFIL EN (US-Streamer -> englische Accounts) =========
# YouTube: Dateien nach ./secrets/en/  (eigenes Google-Projekt empfohlen!)
# Fuer reinen Review-/Telegram-Betrieb statt Upload: PLATFORMS_EN=none
PLATFORMS_EN=youtube
YOUTUBE_PRIVACY_STATUS_EN=private
# Fuer nur manuellen Upload ueber den Telegram-Button: UPLOAD_TIMES_EN=none
UPLOAD_TIMES_EN=10:00
COLLECT_TIME_EN=07:15
IG_USER_ID_EN=
IG_ACCESS_TOKEN_EN=
TIKTOK_ACCESS_TOKEN_EN=

# ========= GEMEINSAM =========
# Oeffentliche HTTPS-URL des Servers (nur fuer Instagram noetig)
# Entweder PUBLIC_BASE_URL direkt setzen ODER PUBLIC_HOSTNAME + Caddy-Profil nutzen.
PUBLIC_BASE_URL=
PUBLIC_HOSTNAME=
META_GRAPH_API_VERSION=v21.0

# Kandidaten-Filter
MIN_CLIP_VIEWS=300
MIN_CLIP_SECONDS=8
MAX_CLIP_SECONDS=75
CANDIDATES_PER_DAY=25
MIN_SCORE=60

WHISPER_MODEL=small
ENABLE_ZOOM=0
